# DARK-AUTH Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://darkauth:darkauth_secret@db:5432/darkauth

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-64-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# HMAC
HMAC_SECRET=change-this-to-another-long-random-secret-key

# File Uploads (client versions)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
